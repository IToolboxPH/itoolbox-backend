# ═══════════════════════════════════════════════════════════════════════════
# itoolbox-backend — API service (apps/api)
# Copy to .env and fill in. Never commit the filled copy.
# ═══════════════════════════════════════════════════════════════════════════

# ── Platform ─────────────────────────────────────────────────────────────────
PLATFORM_ENV=local

# Signs every access token. Required; compose refuses to start without it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# CORS — comma-separated origins of itoolbox-frontend. Ignored when
# PLATFORM_ENV=local (any origin is allowed there).
ALLOWED_ORIGINS=http://localhost:3100

# First super_admin, created on startup only while the user table is empty.
# Leave the password blank to skip. Change it after the first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=IToolbox Admin

# ── Data harness: Zetaris ────────────────────────────────────────────────────
# The agent reads data only through Zetaris (../itoolbox-zetaris-platform). Prefer an
# API key — create one in Zetaris (POST /api/v1.0/auth/api-key) so this file
# never holds a Zetaris password. Username/password is the fallback.
# Locally compose points ZETARIS_API_URL at host.docker.internal:8888; set it
# here only when running uvicorn on the host (http://localhost:8888).
# ZETARIS_API_URL=http://localhost:8888
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# ── Agent models ─────────────────────────────────────────────────────────────
# Each model is listed in the picker; it is usable once its key is set.
# Check a configured model from the API docs: GET /api/v1/agent/models/{id}/check
AGENT_DEFAULT_MODEL=nemotron
# "Demo (no LLM)": a scripted investigation over live data, for UI work.
AGENT_ENABLE_DEMO=true

# NVIDIA Nemotron — key from build.nvidia.com. Model ids: GET /v1/models there.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# xAI Grok — key from console.x.ai. Model ids: GET https://api.x.ai/v1/models
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Anthropic Claude — key from platform.claude.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Claude Opus 5.5 defaults to medium.
ANTHROPIC_EFFORT=high

# ── Local dev via compose.yaml (optional) ────────────────────────────────────
POSTGRES_DB=itoolbox_db
POSTGRES_USER=itoolbox
POSTGRES_PASSWORD=itoolbox
POSTGRES_HOST_PORT=5435
API_PORT=8100
